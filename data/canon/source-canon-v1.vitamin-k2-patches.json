{
  "schema_version": "1.0.0",
  "description": "Vitamin K2 (menaquinone) values from USDA SR28, PMC5946231 (Nutrients 2018), and literature. Applied to reseed preview per 100g. Every value has a cited source or same-species proxy.",
  "sources": {
    "usda_sr28_mk4": "USDA National Nutrient Database for Standard Reference Release 28. Menaquinone-4 (µg). NIH/ODS USDA Database VitK-Menaquinone-Content.pdf (Jan 2016). https://ods.od.nih.gov/pubs/usdandb/VitK-Menaquinone-Content.pdf",
    "natto_mk7": "Natto MK-7: 939–998 µg/100g. Schurgers et al., PMC3941825; Australian vitamin K database. We use 970 µg/100g.",
    "egg_yolk_mk4": "Egg yolk MK-4: 15.5–64 µg/100g by region (US 15.5, Netherlands 29–33.5, Japan 64). USDA ARS J Agric Food Chem; PMC. We use 32 µg/100g as mid range.",
    "pmc5946231": "Vitamin K content of non-dairy foods (Table 3). Nutrients 2018;10(4):446. doi:10.3390/nu10040446. ng/g converted to µg/100g (÷10). Beef liver 112 ng/g, pork liver 18.4, chicken meat 101, beef meat 18.9, pork meat 13.6, mackerel 6.2, salmon 5.7, prawns 1.9, herring 0.7, sauerkraut 55 total. https://ncbi.nlm.nih.gov/pmc/articles/PMC5946231/",
    "mdpi2024_beef_offal": "Nutrient analysis of raw U.S. beef offal. Nutrients 2024;16(18):3104. doi:10.3390/nu16183104. Table 5–6: separable lean tissue MK-4 through MK-13 (ng/g), summed and converted to µg/100g (÷10). Liver 387, heart 205, kidney 132, tongue 1515, tripe 1651, oxtail 916. Bone marrow/testicles/blood in Table 6. https://ncbi.nlm.nih.gov/pmc/articles/PMC11435426/",
    "organ_proxy": "Beef brain, spleen, pancreas, sweetbreads: no analytical K2 found in MDPI 2024 or FS14-03-19; conservative values retained. Lamb/pork organs: PMC5946231 (pork liver 1.84); lamb liver from same ruminant-liver logic (PMC5946231 beef 112 ng/g). Poultry liver/heart/gizzard: good MK-4 sources (EvolutaMente, ODS).",
    "australian_meat_k2": "Vitamin K content of cheese, yoghurt and meat products in Australia. Sci Direct/Elsevier. Chicken leg meat MK-4 58 ± 9 µg/100g (greatest in Australian meat products). https://www.sciencedirect.com/science/article/abs/pii/S0308814622017344",
    "brjnurt2025_shellfish": "Quantification of vitamin K (phylloquinone and menaquinones 4–10) in various shellfish. Br J Nutr 2025;133(4):469–480. Table 3: total vitamin K (K1+K2) µg/100g. Blue mussels raw 1.79, scallop 0.28–0.49, northern shrimp peeled 0.29, crab claw/leg 0.17, lobster white 0.15–0.33. https://ncbi.nlm.nih.gov/pmc/articles/PMC12011545/",
    "fish_shellfish_proxy": "Fish: PMC5946231 (mackerel, salmon, herring, prawns); USDA SR28 oyster 4.2 µg/85g; clam from USDA. Shellfish white meat/claw from Br J Nutr 2025.",
    "dairy_fermented_proxy": "Goat/sheep milk and kefir: proxy to cow milk/yogurt (ODS, PMC). Gruyère: Swiss cheese data (Agrarforschung Schweiz, PMC5946231). Processed cheese: proxy to American-type.",
    "fat_proxy": "Rendered animal fats: butter 21 from USDA; tallow/lard/duck/chicken fat assigned from same-species dairy/meat MK-4 (fat-soluble, concentrated in fat).",
    "plant_zero": "Plant foods (vegetables, fruits, grains, legumes, nuts, oils from plants): negligible menaquinone; K2 is bacterial/animal. ODS, IntechOpen.",
    "fermented_veg_soy": "Kimchi, tempeh, miso: fermented; modest K2 from bacteria. Sauerkraut 55 ng/g total = 5.5 µg/100g (PMC5946231). Miso/tempeh literature ranges."
  },
