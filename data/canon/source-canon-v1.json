{
  "schema_version": "1.0.0",
  "name": "Source Canon Whole Foods",
  "principles": {
    "single_ingredient_only": true,
    "exclude_branded_and_restaurant_items": true,
    "exclude_composite_dishes": true,
    "default_state": "raw_baseline",
    "notes": [
      "Default state is raw unless the food is inherently processed/preserved (e.g., cheese, yogurt, kefir, canned fish).",
      "No fine-grained variants (e.g., grass-fed vs grain-fed) in v1 canon.",
      "Species-level entries preferred for seafood."
    ]
  },
  "canonical_item_schema": {
    "canonical_id": "string",
    "display_name": "string",
    "kingdom": "Animalia | Plantae | Fungi | Algae",
    "domain": "string",
    "group": "string",
    "subgroup": "string",
    "default_state": "raw | preserved | fermented | oil | dairy_processed",
    "aliases": ["string"],
    "variant_template": "string",
    "notes": "string"
  },
  "variant_dimensions": [
    {
      "key": "milkfat_level",
      "label": "Milk fat level",
      "value_type": "enum",
      "allowed_values": ["whole", "2%", "1%", "skim"]
    },
    {
      "key": "yogurt_fat_level",
      "label": "Yogurt fat level",
      "value_type": "enum",
      "allowed_values": ["whole", "lowfat", "nonfat"]
    },
    {
      "key": "cream_type",
      "label": "Cream type",
      "value_type": "enum",
      "allowed_values": ["half_and_half", "light_cream", "heavy_cream"]
    },
    {
      "key": "ground_meat_fat_percent",
      "label": "Ground meat fat percent",
      "value_type": "number",
      "allowed_values": [30, 20, 15, 10, 7, 4]
    }
  ],
  "variant_templates": [
    {
      "template_id": "milk_fat_levels",
      "applies_to": ["Whole milk"],
      "dimensions": [
        { "key": "milkfat_level", "default": "whole" }
      ]
    },
    {
      "template_id": "yogurt_fat_levels",
      "applies_to": ["Yogurt (plain)"],
      "dimensions": [
        { "key": "yogurt_fat_level", "default": "whole" }
      ]
    },
    {
      "template_id": "cream_types",
      "applies_to": ["Cream"],
      "dimensions": [
        { "key": "cream_type", "default": "heavy_cream" }
      ]
    },
    {
      "template_id": "ground_beef_fat_percents",
      "applies_to": ["Ground beef"],
      "dimensions": [
        { "key": "ground_meat_fat_percent", "default": 20 }
      ]
    }
  ],
